{
  "$schema": "./apps/ui/node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".cache/nx",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*"
    ],
    "pythonWorkspace": [
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/mise.toml",
      "{workspaceRoot}/libs/contracts/**/*"
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/mise.toml"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "pythonWorkspace"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "pythonWorkspace",
        "{workspaceRoot}/conftest.py"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    }
  }
}
