{
  "name": "charts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "charts",
  "implicitDependencies": ["core", "ui", "sandbox-exec"],
  "tags": ["scope:infra", "type:charts"],
  "targets": {
    "lint": {
      "command": "make lint-helm lint-kubernetes check-schema lint-checkov",
      "inputs": [
        "default",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/mise.toml",
        "{workspaceRoot}/Makefile",
        "{workspaceRoot}/.kube-linter.yaml",
        "{workspaceRoot}/.checkov.yaml",
        "{workspaceRoot}/.schemas/**/*"
      ]
    }
  }
}
