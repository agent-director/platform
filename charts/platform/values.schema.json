{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceQuantities" },
        "limits": { "$ref": "#/definitions/resourceQuantities" }
      }
    },
    "imageRepoTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "imageWithPullPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "fullnameOverride",
    "nameOverride",
    "adminAllowlist",
    "imagePullSecrets",
    "database",
    "rustfs",
    "secrets",
    "caddyTailscale",
    "unifiedApi",
    "frontend",
    "workers",
    "litellm",
    "langfuse",
    "temporalDev",
    "temporal",
    "sandboxedContainers"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls"],
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["useOcpServingCert"],
          "properties": {
            "useOcpServingCert": { "type": "boolean" }
          }
        }
      }
    },
    "fullnameOverride": { "type": "string" },
    "nameOverride": { "type": "string" },
    "adminAllowlist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamId",
        "version",
        "port",
        "substrateUser",
        "substrateDatabase"
      ],
      "properties": {
        "teamId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "const": 5432 },
        "substrateUser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {
            "anyOf": [
              {
                "enum": [
                  "postgres",
                  "platform",
                  "langfuse",
                  "temporal",
                  "admin"
                ]
              },
              { "pattern": "^pg_" }
            ]
          }
        },
        "substrateDatabase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": {
            "enum": [
              "postgres",
              "template0",
              "template1",
              "platform",
              "langfuse",
              "temporal",
              "temporal_visibility"
            ]
          }
        }
      }
    },
    "rustfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "service",
        "consolePort",
        "persistence",
        "accessKey",
        "secretKey",
        "substrateNamespace"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/imageRepoTag" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "consolePort": { "$ref": "#/definitions/port" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "accessKey": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string" },
        "substrateNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "langfuseNextauthSecret",
        "langfuseSalt",
        "litellmMasterKey"
      ],
      "properties": {
        "langfuseNextauthSecret": { "type": "string" },
        "langfuseSalt": { "type": "string" },
        "litellmMasterKey": { "type": "string" }
      }
    },
    "caddyTailscale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "hostname",
        "tailnet",
        "ephemeral",
        "storage",
        "secretName",
        "caddyConfig"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/imageWithPullPolicy" },
        "hostname": { "type": "string" },
        "tailnet": { "type": "string" },
        "ephemeral": { "type": "boolean" },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "secretName": { "type": "string", "minLength": 1 },
        "caddyConfig": { "type": "string", "minLength": 1 }
      }
    },
    "unifiedApi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image", "githubRepo", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/imageWithPullPolicy" },
        "githubRepo": { "type": "string", "minLength": 1 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/imageWithPullPolicy" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "temporalNamespace",
        "taskQueue",
        "health",
        "substrateNamespace",
        "substratePort"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/imageWithPullPolicy" },
        "temporalNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 46,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "taskQueue": { "type": "string", "minLength": 1 },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "substrateNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "substratePort": { "$ref": "#/definitions/port" }
      }
    },
    "litellm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/imageRepoTag" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        }
      }
    },
    "langfuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/imageRepoTag" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        }
      }
    },
    "temporalDev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "service", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/imageRepoTag" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "fullnameOverride",
        "nameOverride",
        "server",
        "admintools",
        "schema"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "fullnameOverride": { "type": "string" },
        "nameOverride": { "type": "string" },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicaCount",
            "image",
            "resources",
            "frontend",
            "config",
            "nodeSelector",
            "tolerations",
            "affinity",
            "podAnnotations"
          ],
          "properties": {
            "replicaCount": { "type": "integer", "minimum": 1 },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tolerations": {
              "type": "array",
              "items": { "type": "object" }
            },
            "affinity": { "type": "object" },
            "podAnnotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "image": { "$ref": "#/definitions/imageWithPullPolicy" },
            "resources": { "$ref": "#/definitions/resources" },
            "frontend": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service"],
              "properties": {
                "service": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["port"],
                  "properties": {
                    "port": { "$ref": "#/definitions/port" }
                  }
                }
              }
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespaces", "persistence"],
              "properties": {
                "namespaces": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["create", "retention"],
                  "properties": {
                    "create": { "type": "boolean" },
                    "retention": {
                      "type": "string",
                      "pattern": "^([1-9][0-9]*(\\.[0-9]+)?(h|d))+$"
                    }
                  }
                },
                "persistence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["numHistoryShards"],
                  "properties": {
                    "numHistoryShards": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "admintools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": { "$ref": "#/definitions/imageWithPullPolicy" }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backoffLimit",
            "activeDeadlineSeconds",
            "resources",
            "nodeSelector",
            "tolerations",
            "affinity",
            "podAnnotations"
          ],
          "properties": {
            "backoffLimit": { "type": "integer", "minimum": 0 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tolerations": {
              "type": "array",
              "items": { "type": "object" }
            },
            "affinity": { "type": "object" },
            "podAnnotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "resources": { "$ref": "#/definitions/resources" }
          }
        }
      }
    },
    "sandboxedContainers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "channel", "checkNodeEligibility"],
      "properties": {
        "enabled": { "type": "boolean" },
        "channel": { "type": "string", "minLength": 1 },
        "checkNodeEligibility": { "type": "boolean" }
      }
    }
  }
}
