GH_PAT="your-github-personal-access-token"
LANGFUSE_NEXTAUTH_SECRET="your-langfuse-secret"
LANGFUSE_SALT="your-langfuse-salt"
# Your Tailscale auth key (preferably an ephemeral, short-lived OAuth key for CI)
TAILSCALE_AUTH_KEY="tskey-auth-..."
# Your Tailnet domain name (e.g., tail8ec501.ts.net)
TAILSCALE_DOMAIN="your-tailnet.ts.net"

# Examples for manual loopback port-forwards you start yourself; choose free ports.
# Host API/worker startup requires these explicit endpoints; Helm injects cluster values.
# Integration fixtures instead export API_URL, DATABASE_URL, TEMPORAL_ADDRESS and
# substrate endpoints/TLS settings at random loopback ports within pytest only.
# They do not forward LiteLLM or export endpoints back to the calling shell.
LITELLM_URL="http://127.0.0.1:4000"
TEMPORAL_URL="127.0.0.1:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="agent-task-queue"
UVICORN_PORT="8000"
WORKER_HEALTH_PORT="8081"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LITELLM_CONFIG_PATH="/app/unified_api/litellm_config.yaml"
ADMIN_ALLOWLIST_PATH="/etc/unified-api/allowlist.yaml"
# Optional GitOps destination for Unified API configuration pull requests.
GITHUB_REPO="agent-director/platform"
GITHUB_CONFIG_PATH="unified_api/litellm_config.yaml"
