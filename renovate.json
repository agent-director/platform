{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Managed by khepri-deps/renovate \u2014 global config provides weekly Monday schedule, 14-day release cooldown, and vulnerability alert bypass."
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "images/caddy-tailscale/Dockerfile"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "images/sandbox/Dockerfile"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^images/agent-substrate/Dockerfile$"
      ],
      "matchStrings": [
        "git clone --depth 1 -b (?<currentValue>v[0-9\\.]+) https://github\\.com/(?<depName>agent-substrate/substrate)\\.git"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "pip install pyyaml",
      "python3 scripts/update-crds.py"
    ],
    "fileFilters": [
      "charts/agent-substrate/crds/*.yaml"
    ],
    "executionMode": "branch"
  }
}
