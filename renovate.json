{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Managed by khepri-deps/renovate — global config provides weekly Monday schedule, 14-day release cooldown, and vulnerability alert bypass."
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "images/caddy-tailscale/Dockerfile"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "images/sandbox/Dockerfile"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchPackageNames": [
        "agent-substrate/substrate",
        "zalando/postgres-operator"
      ],
      "postUpgradeTasks": {
        "commands": [
          "mise exec -- uv run --locked tools/scripts/update-crds.py all"
        ],
        "fileFilters": [
          "charts/agent-substrate/crds/*.yaml",
          ".schemas/**/*.json"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": [
        "pre-commit/pre-commit-hooks",
        "https://github.com/pre-commit/pre-commit-hooks"
      ],
      "abandonmentThreshold": "2 years"
    },
    {
      "matchPackageNames": [
        "pnpm",
        "ghcr.io/pnpm/pnpm"
      ],
      "groupName": "pnpm"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": true
    },
    {
      "matchPackageNames": [
        "python",
        "python/cpython",
        "docker.io/library/python"
      ],
      "groupName": "python",
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^images/.*/Dockerfile$/",
        "/^tools/scripts/.*\\.(?:sh|py)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+(?:(?:ARG|ENV)[ \\t]+)?[A-Za-z0-9_]+[ \\t]*\\??:?=[ \\t]*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
