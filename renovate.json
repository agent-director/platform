{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Managed by khepri-deps/renovate — global config provides weekly Monday schedule, 14-day release cooldown, and vulnerability alert bypass."
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "images/caddy-tailscale/Dockerfile"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "images/sandbox/Dockerfile"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchPackageNames": [
        "agent-substrate/substrate"
      ],
      "postUpgradeTasks": {
        "commands": [
          "uv run --with pyyaml python scripts/update-crds.py"
        ],
        "fileFilters": [
          "charts/agent-substrate/crds/*.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": [
        "pre-commit/pre-commit-hooks",
        "https://github.com/pre-commit/pre-commit-hooks"
      ],
      "abandonmentThreshold": "2 years"
    },
    {
      "matchManagers": [
        "asdf"
      ],
      "matchPackageNames": [
        "trivy",
        "aquasecurity/trivy"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "jsonata"
      ],
      "matchPackageNames": [
        "bridgecrewio/checkov",
        "https://github.com/bridgecrewio/checkov"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "aquasecurity/trivy-action"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^images/.*/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+[A-Za-z0-9_]+=\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "^\\.tool-versions$"
      ],
      "matchStrings": [
        "trivy (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "^prek\\.toml$"
      ],
      "matchStrings": [
        "repo = \"https://github\\.com/(?<depName>bridgecrewio/checkov)\"\\s*rev = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "^\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "uses: (?<depName>aquasecurity/trivy-action)@(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
